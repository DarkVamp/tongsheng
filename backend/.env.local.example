# Dieses File auf dem Server als .env.local speichern (NICHT committen!)
APP_ENV=prod
APP_SECRET=hier_einen_langen_zufaelligen_wert_eintragen

# MySQL-Zugangsdaten von All-Inkl.com eintragen:
DATABASE_URL="mysql://DB_USER:DB_PASS@localhost:3306/DB_NAME?serverVersion=8.0&charset=utf8mb4"

# Erlaubte Herkunft für CORS (exakte Domain):
CORS_ALLOW_ORIGIN='^https://tongsheng\.app$'

# Pfad für Aufnahmen.
# Empfehlung: backend/var/recordings verwenden – ist durch .htaccess vor Direktzugriffen geschützt.
# %kernel.project_dir% wird von Symfony automatisch zum absoluten Pfad aufgelöst.
RECORDINGS_DIR=%kernel.project_dir%/var/recordings
